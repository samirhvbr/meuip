{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment_perfil": "PERFIL FABLE-5 — Claude Fable 5 (Mythos-class) no model e nos subagentes. Janela 1M SEMPRE ativa na Anthropic API (Fable/Opus 4.8/Opus 4.7 rodam 1M por padrao, nao precisa de flag). Effort 'max' vai pelo env CLAUDE_CODE_EFFORT_LEVEL porque o campo effortLevel do arquivo NAO aceita 'max' (so low/medium/high/xhigh). Thinking no Fable 5 e SEMPRE adaptativo e NAO desliga — CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING nao tem efeito. ATENCAO CREDITOS: Fable 5 incluso no Max ate ~22/jun/2026; depois passa a consumir creditos de uso ($10/$50 por MTok, 2x o Opus). Confirme o status atual antes de rodar pesado. Requer Claude Code v2.1.170+ (claude update).",
  "model": "fable",
  "fallbackModel": ["opus"],
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "fable",
    "ANTHROPIC_DEFAULT_FABLE_MODEL": "claude-fable-5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8",
    "CLAUDE_CODE_EFFORT_LEVEL": "max"
  },
  "permissions": {
    "_comment": "Permissões do projeto - Laravel/Blue3",
    "defaultMode": "plan",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(php artisan about:*)",
      "Bash(php artisan route:list:*)",
      "Bash(php artisan migrate:status:*)",
      "Bash(php artisan view:clear:*)",
      "Bash(php artisan config:clear:*)",
      "Bash(php artisan cache:clear:*)",
      "Bash(php artisan route:clear:*)",
      "Bash(php artisan optimize:clear:*)",
      "Bash(php artisan tinker --execute:*)",
      "Bash(php artisan test:*)",
      "Bash(php artisan make:*)",
      "Bash(php -l:*)",
      "Bash(composer validate:*)",
      "Bash(composer show:*)",
      "Bash(composer install:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(node -c:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm install:*)",
